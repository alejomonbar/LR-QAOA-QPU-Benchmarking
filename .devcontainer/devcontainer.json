{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r scripts/requirements-site.txt && pip3 install --user -e . ; echo '✅ Packages installed'",
  // Build the website data from Data/ and preview the site (the same page GitHub Pages serves)
  "postAttachCommand": {
    "site": "python3 scripts/build_site_data.py && python3 -m http.server -d site 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Website preview",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
